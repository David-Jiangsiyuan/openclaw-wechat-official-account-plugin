# ============================================
# OpenClaw 微信公众号插件 - 环境变量配置模板
# ============================================
# 复制此文件为 .env.wechat 并填写实际值
# cp .env.wechat.template .env.wechat
# ============================================

# ========== 服务器配置 ==========
# 服务器监听地址 (默认: 0.0.0.0)
SERVER_HOST=0.0.0.0

# 服务器监听端口 (默认: 8080)
SERVER_PORT=8080

# 公网可访问的URL (用于微信公众平台配置)
# 格式: https://your-domain.com/wx/webhook
SERVER_PUBLIC_URL=https://your-domain.com/wx/webhook

# ========== 微信公众号配置 ==========
# 微信公众号 AppID (从微信公众平台获取)
# 测试号示例: wxc623cf40b770b852
WECHAT_APP_ID=YOUR_WECHAT_APP_ID

# 微信公众号 AppSecret (从微信公众平台获取)
# 测试号示例: 88f90debad2d55a077cfd8bdf5bc1d5c
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET

# 开发者 Token (用于验证微信服务器请求)
# 可以自定义，建议使用随机字符串
# 示例: openclaw2026
WECHAT_TOKEN=YOUR_TOKEN_HERE

# 消息加解密密钥 (43位字符)
# 可以在微信公众平台"基本配置"中生成
# 注意: 必须是43位
WECHAT_ENCODING_AES_KEY=YOUR_43_CHAR_KEY_HERE

# ========== OpenClaw 配置 ==========
# 知识库 ID (从OpenClaw获取)
OPENCLAW_KNOWLEDGE_BASE_ID=kb-wechat-products

# API 超时时间 (毫秒，默认: 10000)
OPENCLAW_API_TIMEOUT=10000

# ========== 日志配置 ==========
# 日志级别 (error, warn, info, debug, verbose)
LOG_LEVEL=info

# ============================================
# 使用示例:
# ============================================
# 1. 复制模板文件:
#    cp .env.wechat.template .env.wechat
#
# 2. 编辑 .env.wechat，填写实际值
#
# 3. 测试配置:
#    node -e "require('dotenv').config({path: './config/.env.wechat'}); console.log(process.env);"
#
# 4. 启动服务:
#    npm run build && npm start
# ============================================
